---
import { formatDate, readingTime, type Post } from '../lib/posts';

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;

// Group by year, keeping the newest-first order of the input.
const years = new Map<number, Post[]>();
for (const post of posts) {
  const year = post.data.date.getFullYear();
  years.set(year, [...(years.get(year) ?? []), post]);
}
---

{
  [...years.entries()].map(([year, yearPosts]) => (
    <section aria-label={`Posts from ${year}`} class="grid gap-x-8 border-t border-line py-8 sm:grid-cols-[5rem_1fr]">
      <h2 class="font-serif text-lg font-semibold text-muted tabular-nums">{year}</h2>
      <ul class="mt-4 space-y-8 sm:mt-0">
        {yearPosts.map((post) => (
          <li>
            <a href={`/blog/${post.id}`} class="group block">
              <h3 class="font-serif text-xl leading-snug font-semibold tracking-tight transition-colors group-hover:text-accent">
                {post.data.title}
              </h3>
              <p class="mt-2 text-muted">{post.data.description}</p>
            </a>
            <p class="mt-2 text-sm text-muted">
              <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
              <span aria-hidden="true"> · </span>
              {readingTime(post)} min read
            </p>
          </li>
        ))}
      </ul>
    </section>
  ))
}
