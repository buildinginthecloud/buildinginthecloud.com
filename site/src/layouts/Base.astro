---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const siteName = 'Building in the Cloud';
const {
  title,
  description = 'Notes on AWS, CDK, Terraform and building with Claude by Yvo van Zee.',
} = Astro.props;
const pageTitle = title ? `${title} | ${siteName}` : siteName;
const canonical = new URL(Astro.url.pathname, Astro.site);

const nav = [
  { label: 'Blog', href: '/blog' },
  { label: 'About', href: '/about' },
  { label: 'CV', href: '/cv' },
];
const social = [
  { label: 'GitHub', href: 'https://github.com/buildinginthecloud' },
  { label: 'LinkedIn', href: 'https://linkedin.com/in/yvovanzee' },
  { label: 'RSS', href: '/feed.xml' },
];
const isActive = (href: string) => Astro.url.pathname.startsWith(href);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={siteName} href="/feed.xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteName} />
    <script is:inline>
      // Apply a stored theme before first paint to avoid a flash.
      try {
        const stored = localStorage.getItem('theme');
        if (stored === 'light' || stored === 'dark') {
          document.documentElement.dataset.theme = stored;
        }
      } catch {}
    </script>
  </head>
  <body class="flex min-h-screen flex-col">
    <header class="border-b border-line print:hidden">
      <div class="mx-auto flex w-full max-w-3xl items-center justify-between gap-4 px-5 py-5">
        <a href="/" class="font-serif text-base font-semibold tracking-tight whitespace-nowrap sm:text-lg">{siteName}</a>
        <nav aria-label="Main" class="flex items-center gap-3 text-sm sm:gap-5">
          {
            nav.map((item) => (
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class:list={[
                  'transition-colors hover:text-accent',
                  isActive(item.href) ? 'text-fg' : 'text-muted',
                ]}
              >
                {item.label}
              </a>
            ))
          }
          <button
            id="theme-toggle"
            type="button"
            aria-label="Switch between light and dark theme"
            class="cursor-pointer text-muted transition-colors hover:text-accent"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <circle cx="12" cy="12" r="9"></circle>
              <path d="M12 3a9 9 0 0 0 0 18z" fill="currentColor"></path>
            </svg>
          </button>
        </nav>
      </div>
    </header>

    <main class="mx-auto w-full max-w-3xl flex-1 px-5 print:max-w-none print:px-0">
      <slot />
    </main>

    <footer class="mt-24 border-t border-line print:hidden">
      <div class="mx-auto flex w-full max-w-3xl flex-wrap items-center justify-between gap-4 px-5 py-8 text-sm text-muted">
        <p>&copy; {new Date().getFullYear()} Yvo van Zee</p>
        <ul class="flex gap-5">
          {
            social.map((item) => (
              <li>
                <a href={item.href} class="transition-colors hover:text-accent">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </footer>

    <script is:inline>
      document.getElementById('theme-toggle').addEventListener('click', () => {
        const root = document.documentElement;
        const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const current = root.dataset.theme || (systemDark ? 'dark' : 'light');
        const next = current === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch {}
      });
    </script>
  </body>
</html>
