---
import Base from '../layouts/Base.astro';

const linkClass =
  'underline decoration-line decoration-2 underline-offset-4 transition-colors hover:decoration-accent';
---

<Base title="Page not found" description="This page does not exist.">
  <section class="py-24">
    <p class="text-sm font-medium tracking-wide text-accent">404</p>
    <h1 class="mt-4 font-serif text-4xl font-semibold tracking-tight">This page does not exist.</h1>
    <p class="mt-4 max-w-xl text-lg text-muted">
      The link may be outdated or the page may have moved. The blog and the search page are good places to continue.
    </p>
    <ul class="mt-8 flex flex-wrap gap-6 text-sm font-medium">
      <li><a href="/" class={linkClass}>Home</a></li>
      <li><a href="/blog" class={linkClass}>All posts</a></li>
      <li><a href="/search" class={linkClass}>Search</a></li>
    </ul>
  </section>
</Base>
