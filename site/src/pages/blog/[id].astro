---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate, getPosts, readingTime, tagSlug } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const sections = headings.filter((heading) => heading.depth === 2);
---

<Base title={post.data.title} description={post.data.description}>
  <article class="py-14">
    <header class="border-b border-line pb-8">
      <p class="text-sm text-muted">
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, 'long')}</time>
        <span aria-hidden="true"> · </span>
        {readingTime(post)} min read
      </p>
      <h1 class="mt-3 font-serif text-4xl leading-tight font-semibold tracking-tight text-balance">
        {post.data.title}
      </h1>
      <p class="mt-4 text-lg text-muted">{post.data.description}</p>
      {
        post.data.tags.length > 0 && (
          <ul aria-label="Tags" class="mt-6 flex flex-wrap gap-x-4 gap-y-2 text-sm">
            {post.data.tags.map((tag) => (
              <li>
                <a href={`/blog/tag/${tagSlug(tag)}`} class="text-muted transition-colors hover:text-accent">
                  {tag}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </header>

    {
      sections.length >= 3 && (
        <details class="mt-8 rounded-lg border border-line bg-surface px-5 py-4 text-sm">
          <summary class="cursor-pointer font-medium">On this page</summary>
          <ol class="mt-3 space-y-2">
            {sections.map((section) => (
              <li>
                <a href={`#${section.slug}`} class="text-muted transition-colors hover:text-accent">
                  {section.text}
                </a>
              </li>
            ))}
          </ol>
        </details>
      )
    }

    <div class="prose mt-10 max-w-none">
      <Content />
    </div>

    <footer class="mt-14 border-t border-line pt-8 text-sm">
      <a href="/blog" class="text-muted transition-colors hover:text-accent">All posts</a>
    </footer>
  </article>
</Base>
