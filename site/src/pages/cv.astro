---
import Base from '../layouts/Base.astro';
import { certifications, education, skills, workExperience } from '../data/cv';

const skillGroups: { label: string; items: string[] }[] = [
  { label: 'Cloud and architecture', items: skills.cloud },
  { label: 'Infrastructure as code', items: skills.iac },
  { label: 'Programming', items: skills.programming },
  { label: 'Containers', items: skills.containers },
  { label: 'CI/CD and DevOps', items: skills.cicd },
  { label: 'Data and analytics', items: skills.data },
  { label: 'Networking', items: skills.networking },
  { label: 'Security', items: skills.security },
  { label: 'Monitoring', items: skills.monitoring },
  { label: 'Operating systems', items: skills.os },
];

const links = [
  { label: 'LinkedIn', href: 'https://linkedin.com/in/yvovanzee' },
  { label: 'GitHub', href: 'https://github.com/yvthepief' },
  { label: 'Credly', href: 'https://www.credly.com/users/yvo-van-zee' },
];

const linkClass =
  'underline decoration-line decoration-2 underline-offset-4 transition-colors hover:decoration-accent';
const sectionClass = 'border-t border-line py-10 print:py-5';
const headingClass = 'font-serif text-2xl font-semibold tracking-tight';
---

<Base
  title="Curriculum Vitae"
  description="Professional experience and background of Yvo van Zee, Cloud Consultant at Cloudar and AWS Community Builder."
>
  <header class="py-14 print:py-0 print:pb-5">
    <h1 class="font-serif text-4xl font-semibold tracking-tight">Yvo van Zee</h1>
    <p class="mt-3 text-lg font-medium text-accent">Cloud Consultant and AWS Community Builder</p>
    <p class="mt-1 text-muted">AWS Architect, Consultant and Engineer · Netherlands</p>
    <ul class="mt-6 flex flex-wrap gap-6 text-sm font-medium print:hidden">
      {
        links.map((link) => (
          <li>
            <a href={link.href} class={linkClass}>
              {link.label}
            </a>
          </li>
        ))
      }
      <li>
        <button type="button" id="print-cv" class:list={[linkClass, 'cursor-pointer']}>Print or save as PDF</button>
      </li>
    </ul>
    <p class="mt-8 text-lg leading-relaxed print:mt-4 print:text-base">
      Experienced Cloud Consultant with over 16 years in IT, who loves helping companies on their cloud journey.
      Starting in on-premise hosting and infrastructure at Sentia, transitioning to AWS cloud consulting in 2018. From
      setting up Cloud Centers of Excellence, developing AWS Landing Zones, designing complex network architectures, to
      building Data Analytics Platforms on AWS. Everything based on Infrastructure as Code with CI/CD in mind. As a
      proud 6x certified AWS Cloud Consultant and AWS Community Builder, gathering and sharing knowledge runs through my
      veins.
    </p>
  </header>

  <section aria-labelledby="certifications" class={sectionClass}>
    <h2 id="certifications" class={headingClass}>AWS certifications</h2>
    <ul class="mt-6 grid gap-x-8 gap-y-4 sm:grid-cols-2 print:mt-3 print:grid-cols-2 print:gap-y-2">
      {
        certifications.map((cert) => (
          <li>
            <a href={cert.credlyUrl} class="font-medium transition-colors hover:text-accent">
              {cert.name}
            </a>
            <p class="text-sm text-muted">
              {cert.level} · valid until {cert.expiry}
            </p>
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="experience" class={sectionClass}>
    <h2 id="experience" class={headingClass}>Work experience</h2>
    <div class="mt-6 space-y-10 print:mt-3 print:space-y-5">
      {
        workExperience.map((job) => (
          <article class="cv-entry">
            <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
              <h3 class="text-lg font-semibold">
                {job.title} <span class="font-normal text-accent">at {job.company}</span>
              </h3>
              <p class="text-sm text-muted tabular-nums">
                {job.period} · {job.location}
              </p>
            </div>
            <p class="mt-2 text-muted">{job.description}</p>
            {job.highlights && (
              <ul class="mt-3 grid list-disc gap-x-8 gap-y-1 pl-5 text-sm marker:text-muted sm:grid-cols-2 print:grid-cols-2">
                {job.highlights.map((highlight) => (
                  <li>{highlight}</li>
                ))}
              </ul>
            )}
            {job.projects && job.projects.length > 0 && (
              <div class="mt-4 border-l-2 border-line pl-4">
                <h4 class="text-xs font-semibold tracking-wide text-muted uppercase">Projects</h4>
                <ul class="mt-2 space-y-3 text-sm print:space-y-2">
                  {job.projects.map((project) => (
                    <li>
                      <p>
                        <span class="font-medium">{project.client}</span>
                        <span class="text-muted"> · {project.role}</span>
                      </p>
                      {project.description && <p class="mt-1 text-muted">{project.description}</p>}
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </article>
        ))
      }
    </div>
  </section>

  <section aria-labelledby="skills" class={sectionClass}>
    <h2 id="skills" class={headingClass}>Skills and technologies</h2>
    <dl class="mt-6 grid gap-x-8 gap-y-3 text-sm sm:grid-cols-[12rem_1fr] print:mt-3 print:grid-cols-[10rem_1fr] print:gap-y-1">
      {
        skillGroups.map((group) => (
          <>
            <dt class="font-medium">{group.label}</dt>
            <dd class="text-muted">{group.items.join(', ')}</dd>
          </>
        ))
      }
    </dl>
  </section>

  <section aria-labelledby="education" class={sectionClass}>
    <h2 id="education" class={headingClass}>Education</h2>
    <ul class="mt-6 space-y-5 print:mt-3 print:space-y-2">
      {
        education.map((edu) => (
          <li class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
            <div>
              <p class="font-medium">{edu.degree}</p>
              <p class="text-sm text-muted">
                {edu.field} · {edu.school}
              </p>
            </div>
            <p class="text-sm text-muted tabular-nums">{edu.period}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="contact" class:list={[sectionClass, 'print:hidden']}>
    <h2 id="contact" class={headingClass}>Let's work together</h2>
    <p class="mt-4 max-w-xl text-muted">Interested in collaborating on cloud projects or need AWS consultancy?</p>
    <ul class="mt-5 flex flex-wrap gap-6 text-sm font-medium">
      <li><a href="mailto:yvo@cloudar.be" class={linkClass}>Get in touch</a></li>
      <li><a href="https://cloudar.be" class={linkClass}>Visit Cloudar</a></li>
    </ul>
  </section>

  <script is:inline>
    document.getElementById('print-cv').addEventListener('click', () => window.print());
  </script>
</Base>
