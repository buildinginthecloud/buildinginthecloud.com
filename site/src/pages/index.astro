---
import Base from '../layouts/Base.astro';
import CloudMark from '../components/CloudMark.astro';

import { formatDate, getPosts } from '../lib/posts';

const posts = (await getPosts()).slice(0, 6);

const links = [
  { label: 'LinkedIn', href: 'https://linkedin.com/in/yvovanzee' },
  { label: 'GitHub', href: 'https://github.com/buildinginthecloud' },
];
---

<Base>
  <section class="grid items-center gap-10 py-16 sm:grid-cols-[1fr_15rem] sm:py-24">
    <div>
      <p class="text-sm font-medium tracking-wide text-accent">AWS · CDK · Terraform · Claude</p>
      <h1 class="mt-4 font-serif text-4xl leading-tight font-semibold tracking-tight text-balance sm:text-5xl">
        I build things in the cloud and write down what I learn.
      </h1>
      <p class="mt-6 max-w-xl text-lg text-muted">
        I'm Yvo van Zee, Cloud Consultant at Cloudar and AWS Community Builder. This is where I write about AWS,
        infrastructure as code with CDK and Terraform, and building with Claude, the AI model from Anthropic.
      </p>
      <ul class="mt-8 flex gap-6 text-sm font-medium">
        {
          links.map((link) => (
            <li>
              <a href={link.href} class="underline decoration-line decoration-2 underline-offset-4 transition-colors hover:decoration-accent">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="order-first max-w-48 sm:order-none sm:max-w-none">
      <CloudMark />
    </div>
  </section>

  <section aria-labelledby="latest" class="border-t border-line py-14">
    <div class="flex items-baseline justify-between">
      <h2 id="latest" class="font-serif text-2xl font-semibold tracking-tight">Latest writing</h2>
      <a href="/blog" class="text-sm text-muted transition-colors hover:text-accent">All posts</a>
    </div>
    <ul class="mt-6 divide-y divide-line">
      {
        posts.map((post) => (
          <li>
            <a href={`/blog/${post.id}`} class="group flex flex-col gap-1 py-4 sm:flex-row sm:items-baseline sm:gap-6">
              <time datetime={post.data.date.toISOString()} class="w-28 shrink-0 text-sm text-muted tabular-nums">
                {formatDate(post.data.date)}
              </time>
              <span class="font-medium transition-colors group-hover:text-accent">{post.data.title}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="about" class="border-t border-line py-14">
    <h2 id="about" class="font-serif text-2xl font-semibold tracking-tight">About</h2>
    <p class="mt-4 max-w-xl text-muted">
      I believe infrastructure should be as enjoyable to build as the applications running on it. When I'm not
      deploying stacks, I'm exploring new AWS services or contributing to open source.
    </p>
    <a href="/about" class="mt-5 inline-block text-sm font-medium underline decoration-line decoration-2 underline-offset-4 transition-colors hover:decoration-accent">
      More about me
    </a>
  </section>
</Base>
