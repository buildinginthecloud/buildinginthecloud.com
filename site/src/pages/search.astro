---
import Base from '../layouts/Base.astro';
---

<Base title="Search" description="Search all articles on Building in the Cloud.">
  <header class="py-14">
    <h1 class="font-serif text-4xl font-semibold tracking-tight">Search</h1>
    <form id="search-form" role="search" class="mt-8">
      <label for="search-input" class="sr-only">Search articles</label>
      <input
        id="search-input"
        name="q"
        type="search"
        autocomplete="off"
        placeholder="Search articles, for example cdk-nag"
        class="w-full rounded-lg border border-line bg-surface px-4 py-3 text-lg placeholder:text-muted focus:border-accent focus:outline-none"
      />
    </form>
    <p id="search-status" role="status" class="mt-4 text-sm text-muted"></p>
  </header>
  <ol id="search-results" class="divide-y divide-line border-t border-line empty:border-0"></ol>

  <!--
    The index in /pagefind/ is generated by Pagefind after "astro build". On
    the dev server it only exists after "npm run search:index" (compose.yaml
    runs that at startup). The script is inline because the bundle is not part
    of the Vite module graph.
  -->
  <script is:inline type="module">
    const input = document.getElementById('search-input');
    const status = document.getElementById('search-status');
    const list = document.getElementById('search-results');
    const MAX_RESULTS = 10;
    const DEBOUNCE_MS = 200;

    let pagefind;
    try {
      pagefind = await import('/pagefind/pagefind.js');
      await pagefind.init();
    } catch {
      status.textContent = 'The search index is not available. Run "npm run search:index" to generate it.';
      input.disabled = true;
    }

    // Pagefind indexes the built files (/blog/post.html); link to the clean URL.
    const cleanUrl = (url) => url.replace(/\.html$/, '');

    function render(pages, total, query) {
      list.replaceChildren(
        ...pages.map((page) => {
          const item = document.createElement('li');
          item.className = 'py-5';
          const link = document.createElement('a');
          link.href = cleanUrl(page.url);
          link.className = 'font-serif text-xl font-semibold tracking-tight transition-colors hover:text-accent';
          link.textContent = page.meta.title;
          const excerpt = document.createElement('p');
          excerpt.className = 'search-excerpt mt-2 text-muted';
          // The excerpt is HTML generated by Pagefind: escaped page text with <mark> around the matches.
          excerpt.innerHTML = page.excerpt;
          item.append(link, excerpt);
          return item;
        }),
      );
      if (total === 0) {
        status.textContent = `No articles found for "${query}".`;
      } else {
        const shown = total > pages.length ? `, showing the first ${pages.length}` : '';
        status.textContent = `${total} ${total === 1 ? 'article' : 'articles'} found${shown}.`;
      }
    }

    let latest = 0;

    async function run(query) {
      const sequence = ++latest;
      const url = new URL(location.href);
      if (query) {
        url.searchParams.set('q', query);
      } else {
        url.searchParams.delete('q');
      }
      history.replaceState(null, '', url);

      if (!query) {
        list.replaceChildren();
        status.textContent = '';
        return;
      }
      const search = await pagefind.search(query);
      const pages = await Promise.all(search.results.slice(0, MAX_RESULTS).map((result) => result.data()));
      if (sequence !== latest) return; // A newer search superseded this one.
      render(pages, search.results.length, query);
    }

    if (pagefind) {
      document.getElementById('search-form').addEventListener('submit', (event) => event.preventDefault());
      let timer;
      input.addEventListener('input', () => {
        clearTimeout(timer);
        timer = setTimeout(() => run(input.value.trim()), DEBOUNCE_MS);
      });
      const initial = new URLSearchParams(location.search).get('q');
      if (initial) {
        input.value = initial;
        run(initial.trim());
      }
      input.focus();
    }
  </script>
</Base>
